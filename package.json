{
  "name": "uptime",
  "version": "1.0.0",
  "private": true,
  "description": "站点可用性监控：Cloudflare Workers + D1 + Durable Object",
  "scripts": {
    "setup": "node scripts/setup-d1.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/setup-d1.mjs && wrangler deploy",
    "deploy:preview": "node scripts/setup-d1.mjs && wrangler deploy --env preview",
    "db:init": "wrangler d1 execute site-monitor-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute site-monitor-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.136.3"
  }
}
