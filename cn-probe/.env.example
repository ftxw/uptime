# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不会入库。
#
# PROBE_TOKEN：探测臂与主项目之间的共享密钥，**必设**。
#   未设置时三个接口全部返回 503（fail-closed）—— 这是刻意的：
#   默认放行等于把探测臂变成任何人都能用的开放代理（它能替你从境内打任意 URL）。
#   生成：openssl rand -hex 32
#   主项目侧对应「设置 → 探测 → 探测臂令牌」，两边必须一致。
PROBE_TOKEN=

# EXPECT_EGRESS_COUNTRY：期望的出口归属国家，默认 CN。
#   /api/ping 会用它比对出网 IP 的真实归属并给出 match / mismatch / unknown；
#   /api/probe 与 /api/ssl 的响应里也会带上 egressVerdict，供主项目记录与告警。
#   想临时关闭校验设成空字符串即可（verdict 变成 unchecked）。
EXPECT_EGRESS_COUNTRY=CN
